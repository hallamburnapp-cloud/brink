# Copy to .env.local for local development. All values optional; defaults are the free, offline build.

# Public URL used in share text and Open Graph tags
VITE_PUBLIC_URL=https://brink.example
VITE_SUPPORT_EMAIL=

# Monetisation (Daily free; Endless one-time purchase)
VITE_PAYWALL=false
VITE_STRIPE_PAYMENT_LINK=
VITE_UNLOCK_WORKER_URL=
VITE_UNLOCK_PUBLIC_KEY=

# Build flavour: web | itch | desktop | mobile. itch/desktop builds ship everything unlocked.
VITE_FLAVOUR=web
VITE_ALL_UNLOCKED=false

# Cookie-free analytics: off | plausible | cloudflare
VITE_ANALYTICS=off
VITE_ANALYTICS_DOMAIN=
VITE_ANALYTICS_TOKEN=

# Deployment
# BRINK_BASE=/            # Vite base path
# VITE_APP_VERSION=       # set by CI to the commit SHA
# The price shown in the app next to the unlock button (the Stripe page charges; this is the promise)
VITE_PRICE_LABEL=$3.99
