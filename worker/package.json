{
  "name": "brink-unlock-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cloudflare Worker that turns a paid Stripe Checkout session into a signed BRINK Endless unlock token.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
