    "keygen": "node scripts/keygen.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.2",
    "wrangler": "^4.0.0"
  }
}
