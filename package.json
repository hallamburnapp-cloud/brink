{
  "name": "brink",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "BRINK \u2014 a run-based crisis-strategy game about holding the world together.",
  "author": "Hallam Burnapp",
  "license": "SEE LICENSE IN LICENSE.md",
  "scripts": {
    "dev": "vite",
    "dev:war": "VITE_GAME=war vite",
    "dev:thirty": "VITE_GAME=thirty vite",
    "dev:redlines": "VITE_GAME=redlines vite",
    "build": "npm run content:validate && npm run og && vite build",
    "build:war": "VITE_GAME=war BRINK_BASE=./ vite build --outDir dist-war",
    "build:war-page": "VITE_GAME=war VITE_PWA=off VITE_WAR_REVIEW=1 BRINK_BASE=./ vite build --outDir dist-war-page",
    "build:thirty": "npm run content:validate:thirty && VITE_GAME=thirty BRINK_BASE=./ vite build --outDir dist-thirty",
    "build:thirty-page": "npm run content:validate:thirty && VITE_GAME=thirty VITE_PWA=off BRINK_BASE=./ vite build --outDir dist-thirty-page",
    "build:redlines": "npm run content:validate:redlines -- --strict && VITE_GAME=redlines BRINK_BASE=./ vite build --outDir dist-redlines",
    "build:redlines-page": "npm run content:validate:redlines -- --strict && VITE_GAME=redlines VITE_PWA=off BRINK_BASE=./ vite build --outDir dist-redlines-page",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:war": "vitest run src/war",
    "test:thirty": "vitest run src/thirty tools/thirty",
    "test:redlines": "vitest run src/redlines",
    "test:watch": "vitest",
    "content:validate": "tsx tools/validate.ts",
    "content:validate:crisis": "BRINK_CONTENT_DIR=content-crisis tsx tools/validate.ts",
    "content:validate:thirty": "tsx tools/thirty-validate.ts",
    "content:validate:redlines": "tsx tools/redlines-validate.ts",
    "content:compile": "tsx tools/compile.ts",
    "sim": "tsx tools/sim.ts",
    "sim:war": "tsx tools/war-sim.ts --strict",
    "sim:thirty": "tsx tools/thirty-sim.ts --strict",
    "sim:redlines": "tsx tools/redlines-sim.ts --pack content-redlines --strict",
    "sim:smoke": "tsx tools/sim.ts --mode night --runs 1000 --policy heuristic,random --quiet --strict",
    "sim:smoke:crisis": "BRINK_CONTENT_DIR=content-crisis tsx tools/sim.ts --runs 300 --quiet",
    "sim:smoke:night": "BRINK_CONTENT_DIR=content-crisis tsx tools/sim.ts --mode night --runs 1000 --policy heuristic,random --quiet --strict",
    "og": "tsx tools/og-image.ts",
    "e2e": "playwright test",
    "e2e:war": "playwright test -c playwright.war.config.ts",
    "e2e:thirty": "playwright test -c playwright.thirty.config.ts",
    "e2e:redlines": "playwright test -c playwright.redlines.config.ts",
    "build:itch": "tsx tools/build-itch.ts",
    "size": "tsx tools/size-check.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.0",
    "js-yaml": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "zod": "^4.1.0"
  }
}
